#!/usr/bin/sh
# dashi-portal: Dashi's xdg-desktop-portal backend (packages/shell/apps/portal),
# org.freedesktop.impl.portal.desktop.dashi on the session bus. Not run by
# hand: xdg-desktop-portal activates it over D-Bus
# (org.freedesktop.impl.portal.desktop.dashi.service), which starts the
# dashi-portal user unit.
#
# Finds the shell next to itself, installed (<prefix>/share/dashi/shell) or in
# a checkout (<repo>/packages/shell), and bun next to itself (<prefix>/libexec/dashi/bin)
# or Dashi's installed one (a checkout on an installed Dashi), or in the usual places.
set -eu

self=$(readlink -f -- "$0")
base=$(dirname -- "$(dirname -- "$self")")
if [ -f "$base/share/dashi/shell/apps/portal/main.tsx" ]; then
  script=$base/share/dashi/shell/apps/portal/main.tsx
elif [ -f "$base/packages/shell/apps/portal/main.tsx" ]; then
  script=$base/packages/shell/apps/portal/main.tsx
else
  echo "dashi-portal: can't find the shell next to $self" >&2
  exit 1
fi

# Dashi's own Bun first when installed from its packages (dashi-bun).
bun=${DASHI_BUN:-}
if [ -z "$bun" ] && [ -x "$base/libexec/dashi/bin/bun" ]; then bun=$base/libexec/dashi/bin/bun; fi
[ -n "$bun" ] || bun=$(command -v bun 2>/dev/null || true)
if [ -z "$bun" ]; then
  for candidate in /usr/libexec/dashi/bin/bun "${HOME:-/nonexistent}/.bun/bin/bun" /usr/local/bin/bun /usr/bin/bun; do
    if [ -x "$candidate" ]; then bun=$candidate; break; fi
  done
fi
if [ ! -x "${bun:-}" ]; then
  echo "dashi-portal: bun not found; install it (https://bun.sh) or set DASHI_BUN" >&2
  exit 1
fi
# The Metal host its dialogs are drawn by: the installed one, unless the session says otherwise.
if [ -z "${DASHI_METAL_HOST:-}" ] && [ -x "$base/libexec/dashi/mirin-metal-host" ]; then
  DASHI_METAL_HOST=$base/libexec/dashi/mirin-metal-host
  export DASHI_METAL_HOST
fi
exec "$bun" "$script" "$@"
