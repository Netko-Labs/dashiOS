#!/usr/bin/sh
# dashi-dialog: Dashi's dialogs for shell scripts, with Zenity's command line,
# stdin, output, and exit status (0 OK, 1 Cancel, 5 timed out, 255 an error).
#
#   dashi-dialog --question --text "Delete the file?" && rm file
#
# Finds the shell next to itself, installed (<prefix>/share/dashi/shell) or in
# a checkout (<repo>/packages/shell), and bun next to itself (<prefix>/libexec/dashi/bin)
# or Dashi's installed one (a checkout on an installed Dashi), or in the usual places.
set -eu

self=$(readlink -f -- "$0")
base=$(dirname -- "$(dirname -- "$self")")
if [ -f "$base/share/dashi/shell/apps/dialog/main.tsx" ]; then
  script=$base/share/dashi/shell/apps/dialog/main.tsx
elif [ -f "$base/packages/shell/apps/dialog/main.tsx" ]; then
  script=$base/packages/shell/apps/dialog/main.tsx
else
  echo "dashi-dialog: can't find the shell next to $self" >&2
  exit 255
fi

# Dashi's own Bun first when installed from its packages (dashi-bun).
bun=${DASHI_BUN:-}
if [ -z "$bun" ] && [ -x "$base/libexec/dashi/bin/bun" ]; then bun=$base/libexec/dashi/bin/bun; fi
[ -n "$bun" ] || bun=$(command -v bun 2>/dev/null || true)
if [ -z "$bun" ]; then
  for candidate in /usr/libexec/dashi/bin/bun "${HOME:-/nonexistent}/.bun/bin/bun" /usr/local/bin/bun /usr/bin/bun; do
    if [ -x "$candidate" ]; then bun=$candidate; break; fi
  done
fi
if [ ! -x "${bun:-}" ]; then
  echo "dashi-dialog: bun not found; install it (https://bun.sh) or set DASHI_BUN" >&2
  exit 255
fi
exec "$bun" "$script" "$@"
