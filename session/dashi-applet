#!/usr/bin/sh
# dashi-applet: making an applet (docs/applets.md, "The dev loop"):
# new NAME, dev [--vm], pack, publish, keygen, install FILE, check.
#
# Finds the SDK next to itself, installed (<prefix>/share/dashi/node_modules/@dashi/applet)
# or in a checkout (<repo>/packages/applet), and bun as dashi-dialog does.
set -eu

self=$(readlink -f -- "$0")
base=$(dirname -- "$(dirname -- "$self")")
if [ -f "$base/share/dashi/node_modules/@dashi/applet/src/cli/main.ts" ]; then
  script=$base/share/dashi/node_modules/@dashi/applet/src/cli/main.ts
elif [ -f "$base/packages/applet/src/cli/main.ts" ]; then
  script=$base/packages/applet/src/cli/main.ts
else
  echo "dashi-applet: can't find the SDK next to $self" >&2
  exit 1
fi

bun=${DASHI_BUN:-}
if [ -z "$bun" ] && [ -x "$base/libexec/dashi/bin/bun" ]; then bun=$base/libexec/dashi/bin/bun; fi
[ -n "$bun" ] || bun=$(command -v bun 2>/dev/null || true)
if [ -z "$bun" ]; then
  for candidate in /usr/libexec/dashi/bin/bun "${HOME:-/nonexistent}/.bun/bin/bun" /usr/local/bin/bun /usr/bin/bun; do
    if [ -x "$candidate" ]; then bun=$candidate; break; fi
  done
fi
[ -n "$bun" ] || { echo "dashi-applet: no bun found" >&2; exit 1; }

exec "$bun" "$script" "$@"
