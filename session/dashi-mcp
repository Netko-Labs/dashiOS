#!/usr/bin/sh
# dashi-mcp: Dashi's MCP server for agents, over stdio. It bridges stdin and
# stdout to the running session's socket ($XDG_RUNTIME_DIR/dashi-mcp.sock);
# the person at the screen is asked before the agent may see or do anything.
#
#   claude mcp add dashi -- dashi-mcp
#
# Finds the shell next to itself, installed (<prefix>/share/dashi/shell) or in
# a checkout (<repo>/packages/shell), and bun next to itself (<prefix>/libexec/dashi/bin)
# or Dashi's installed one (a checkout on an installed Dashi), or in the usual places.
set -eu

self=$(readlink -f -- "$0")
base=$(dirname -- "$(dirname -- "$self")")
if [ -f "$base/share/dashi/shell/bin/dashi-mcp.ts" ]; then
  script=$base/share/dashi/shell/bin/dashi-mcp.ts
elif [ -f "$base/packages/shell/bin/dashi-mcp.ts" ]; then
  script=$base/packages/shell/bin/dashi-mcp.ts
else
  echo "dashi-mcp: can't find the shell next to $self" >&2
  exit 1
fi

# Dashi's own Bun first when installed from its packages (dashi-bun).
bun=${DASHI_BUN:-}
if [ -z "$bun" ] && [ -x "$base/libexec/dashi/bin/bun" ]; then bun=$base/libexec/dashi/bin/bun; fi
[ -n "$bun" ] || bun=$(command -v bun 2>/dev/null || true)
if [ -z "$bun" ]; then
  for candidate in /usr/libexec/dashi/bin/bun "${HOME:-/nonexistent}/.bun/bin/bun" /usr/local/bin/bun /usr/bin/bun; do
    if [ -x "$candidate" ]; then bun=$candidate; break; fi
  done
fi
if [ ! -x "${bun:-}" ]; then
  echo "dashi-mcp: bun not found; install it (https://bun.sh) or set DASHI_BUN" >&2
  exit 1
fi
exec "$bun" "$script" "$@"
