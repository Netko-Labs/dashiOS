# The Dashi session as systemd --user sees it: started by the session
# supervisor (shell/src/session/) once the display is known, stopped when the
# session ends. It brings graphical-session.target up, which services such as
# xdg-desktop-portal require: without it apps get no portal (no Dark Mode for
# libadwaita, no file chooser, no screen sharing).
[Unit]
Description=Dashi session
Documentation=https://github.com/Netko-Labs/dashiOS/blob/main/docs/architecture.md
BindsTo=graphical-session.target
# The end goes the other way too: without this, stopping the session's target
# left graphical-session.target up, so xdg-desktop-portal ran on at the login
# screen and started Dashi's portal backend again, with no compositor to draw on.
PropagatesStopTo=graphical-session.target
Wants=graphical-session-pre.target
After=graphical-session-pre.target
