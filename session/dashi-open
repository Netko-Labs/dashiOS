#!/usr/bin/sh
# dashi-open: opens a dashi:// link in the running Dashi session: a setting's
# row in System Settings, an app's menu item, a window, one of Dashi's own
# commands (docs/actions.md). xdg-open and gio open reach it through the
# x-scheme-handler/dashi desktop entry the shell writes.
#
#   dashi-open dashi://settings/appearance/dark-mode
#
# Finds the shell next to itself, installed (<prefix>/share/dashi/shell) or in
# a checkout (<repo>/packages/shell), and bun next to itself (<prefix>/libexec/dashi/bin)
# or Dashi's installed one (a checkout on an installed Dashi), or in the usual places.
set -eu

self=$(readlink -f -- "$0")
base=$(dirname -- "$(dirname -- "$self")")
if [ -f "$base/share/dashi/shell/bin/dashi-open.ts" ]; then
  script=$base/share/dashi/shell/bin/dashi-open.ts
elif [ -f "$base/packages/shell/bin/dashi-open.ts" ]; then
  script=$base/packages/shell/bin/dashi-open.ts
else
  echo "dashi-open: can't find the shell next to $self" >&2
  exit 1
fi

# Dashi's own Bun first when installed from its packages (dashi-bun).
bun=${DASHI_BUN:-}
if [ -z "$bun" ] && [ -x "$base/libexec/dashi/bin/bun" ]; then bun=$base/libexec/dashi/bin/bun; fi
[ -n "$bun" ] || bun=$(command -v bun 2>/dev/null || true)
if [ -z "$bun" ]; then
  for candidate in /usr/libexec/dashi/bin/bun "${HOME:-/nonexistent}/.bun/bin/bun" /usr/local/bin/bun /usr/bin/bun; do
    if [ -x "$candidate" ]; then bun=$candidate; break; fi
  done
fi
if [ ! -x "${bun:-}" ]; then
  echo "dashi-open: bun not found; install it (https://bun.sh) or set DASHI_BUN" >&2
  exit 1
fi
exec "$bun" "$script" "$@"
