#!/usr/bin/sh
# dashi-browser-host: the native messaging host of Dashi's browser extension.
# The browser starts it (its manifest, dev.dashi.browser, allows only Dashi's
# extension); it relays between the extension and the running shell's socket
# ($XDG_RUNTIME_DIR/dashi-browser.sock). docs/actions.md, "Websites".
#
# Installed at <prefix>/libexec/dashi/dashi-browser-host: finds the shell at
# <prefix>/share/dashi/shell, or in a checkout (<repo>/packages/shell) when
# this is <repo>/session/dashi-browser-host or a link to it.
set -eu

self=$(readlink -f -- "$0")
dir=$(dirname -- "$self")
script=
for base in "$(dirname -- "$dir")" "$(dirname -- "$(dirname -- "$dir")")"; do
  if [ -f "$base/share/dashi/shell/bin/dashi-browser-host.ts" ]; then
    script=$base/share/dashi/shell/bin/dashi-browser-host.ts; break
  elif [ -f "$base/packages/shell/bin/dashi-browser-host.ts" ]; then
    script=$base/packages/shell/bin/dashi-browser-host.ts; break
  fi
done
if [ -z "$script" ]; then
  echo "dashi-browser-host: can't find the shell next to $self" >&2
  exit 1
fi

# Dashi's own Bun first (dashi-bun), then the usual places.
bun=${DASHI_BUN:-}
for candidate in /usr/libexec/dashi/bin/bun "${HOME:-/nonexistent}/.bun/bin/bun" /usr/local/bin/bun /usr/bin/bun; do
  if [ -z "$bun" ] && [ -x "$candidate" ]; then bun=$candidate; fi
done
[ -n "$bun" ] || bun=$(command -v bun 2>/dev/null || true)
if [ ! -x "${bun:-}" ]; then
  echo "dashi-browser-host: bun not found" >&2
  exit 1
fi
exec "$bun" "$script" "$@"
