#!/usr/bin/env bash
# vm/vm: a Dashi VM for developing Dashi, so a broken compositor or shell
# breaks a window and not the session you are working in.
#
#   vm/vm install [ISO]   boot the Dashi image with the VM's disk attached, to
#                         install onto it (Anaconda); makes the disk if needed
#   vm/vm desktop         boot the installed VM
#   vm/vm live [ISO]      boot the image alone, nothing kept
#   vm/vm ssh [ARGS...]   ssh into the running VM (localhost:$DASHI_VM_SSH)
#   vm/vm mcp             Dashi's MCP server in the VM's session, on stdio (the
#                         agent integration, over ssh): `claude mcp add dashi-vm
#                         -- vm/vm mcp`, or vm/agent from a shell
#   vm/vm ipc METHOD [JSON] one request to the VM's compositor (docs/compositor-ipc.md)
#   vm/vm screenshot [PNG] save what the VM's screen shows (vm/images/screen.png)
#   vm/vm type TEXT       type on the VM's keyboard; vm/vm key ctrl-alt-t ret
#   vm/vm stop            ask the guest to shut down
#   vm/vm checkout-session on|off   log the VM in to the session from the
#                         shared checkout (vm/dev-session), or back to Dashi's
#   vm/vm checkout-greeter on|off   greetd with the checkout's login screen
#                         (session/dashi-greeter), or back to SDDM; it offers
#                         "Dashi (new compositor)": the session on the
#                         checkout's dashi-comp (target/debug)
#
# The VM gets KVM, UEFI, and a virtio GPU with Venus, so the guest's Vulkan
# (GPUI, mirin-metal-host) runs on the host's GPU. `desktop` also shares the
# directory that holds this checkout and ../mirin (normally ~/Developer) over
# virtiofs, tag "developer"; in the guest:
#
#   sudo mount -t virtiofs developer /mnt/developer
#
# Environment: DASHI_VM_CPUS (8), DASHI_VM_MEM (8G), DASHI_VM_DISK_SIZE (80G),
# DASHI_VM_RES (1920x1080), DASHI_VM_HEADS (1; 2 for a second screen), DASHI_VM_SSH (2222),
# DASHI_VM_GPU (venus | virgl | none), DASHI_VM_HOST_GPU (mesa | any: which host
# drivers the VM's 3D may use; mesa keeps it off an NVIDIA card), DASHI_VM_USER (dashi),
# DASHI_VM_PASSWORD (for sudo in the guest; checkout-session), DASHI_VM_EXTRA_DISK
# (a qcow2 image `desktop` attaches as a second disk, for the installer: vm/images/install-test.qcow2).
set -euo pipefail

here=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)
repo=$(dirname -- "$here")
share=$(dirname -- "$repo")
images=$here/images
disk=$images/dashi.qcow2
vars=$images/OVMF_VARS.fd
fs_sock=$images/virtiofs.sock
qmp_sock=$images/qmp.sock

cpus=${DASHI_VM_CPUS:-8}
mem=${DASHI_VM_MEM:-8G}
disk_size=${DASHI_VM_DISK_SIZE:-80G}
ssh_port=${DASHI_VM_SSH:-2222}
gpu=${DASHI_VM_GPU:-venus}
host_gpu=${DASHI_VM_HOST_GPU:-mesa}
res=${DASHI_VM_RES:-1920x1080}
heads=${DASHI_VM_HEADS:-1}

die() { echo "vm: $*" >&2; exit 1; }

default_iso() {
  local iso
  iso=$(ls -t "$images"/*.iso 2>/dev/null | head -1 || true)
  [ -n "$iso" ] || die "no ISO in $images; pass one: vm/vm install path/to/dashi.iso"
  echo "$iso"
}

ensure_disk() {
  mkdir -p "$images"
  [ -f "$disk" ] || qemu-img create -q -f qcow2 "$disk" "$disk_size"
  [ -f "$vars" ] || cp /usr/share/edk2/ovmf/OVMF_VARS.fd "$vars"
}

gpu_args() {
  case $heads in 1|2|3|4) ;; *) die "DASHI_VM_HEADS must be 1 to 4" ;; esac
  local size=",xres=${res%x*},yres=${res#*x},max_outputs=$heads"
  case $gpu in
    venus) echo "-device virtio-vga-gl,hostmem=4G,blob=true,venus=true$size -display gtk,gl=on" ;;
    virgl) echo "-device virtio-vga-gl$size -display gtk,gl=on" ;;
    none)  echo "-device virtio-vga$size -display gtk" ;;
    *) die "DASHI_VM_GPU must be venus, virgl, or none" ;;
  esac
}

# The VM's 3D runs on Mesa's drivers only (the AMD or Intel GPU), never the
# NVIDIA card: on the G14 that card fell off the bus under the VM's Venus load
# (2026-11-07), and the host's own desktop never draws on it.
host_gpu_env() {
  case $host_gpu in
    any) ;;
    mesa)
      export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json
      local icds=() f
      for f in /usr/share/vulkan/icd.d/*.x86_64.json; do
        case $f in */nvidia_icd.*) ;; *) icds+=("$f") ;; esac
      done
      VK_DRIVER_FILES=$(IFS=:; echo "${icds[*]}")
      export VK_DRIVER_FILES
      ;;
    *) die "DASHI_VM_HOST_GPU must be mesa or any" ;;
  esac
}

qemu() {
  [ -w /dev/kvm ] || die "/dev/kvm is not usable"
  host_gpu_env
  # Shared memory backs both Venus's blob resources and virtiofs.
  # shellcheck disable=SC2046
  exec qemu-system-x86_64 \
    -name Dashi -machine q35,accel=kvm,memory-backend=mem -cpu host \
    -smp "$cpus" -m "$mem" \
    -object memory-backend-memfd,id=mem,size="$mem",share=on \
    -drive if=pflash,format=raw,readonly=on,file=/usr/share/edk2/ovmf/OVMF_CODE.fd \
    -drive if=pflash,format=raw,file="$vars" \
    $(gpu_args) \
    -device virtio-keyboard-pci -device virtio-tablet-pci \
    -nic user,model=virtio-net-pci,hostfwd=tcp:127.0.0.1:"$ssh_port"-:22 \
    -device virtio-rng-pci \
    -qmp unix:"$qmp_sock",server=on,wait=off \
    "$@"
}

start_virtiofsd() {
  rm -f "$fs_sock"
  /usr/libexec/virtiofsd --socket-path="$fs_sock" --shared-dir="$share" \
    --sandbox=none --cache=auto >"$images/virtiofsd.log" 2>&1 &
  for _ in $(seq 50); do [ -S "$fs_sock" ] && return; sleep 0.1; done
  die "virtiofsd did not start; see $images/virtiofsd.log"
}

cmd=${1:-}; [ $# -gt 0 ] && shift
case $cmd in
  install)
    iso=${1:-$(default_iso)}
    ensure_disk
    qemu -drive file="$disk",if=virtio,format=qcow2 \
      -drive file="$iso",media=cdrom,readonly=on -boot order=d,menu=on
    ;;
  desktop)
    [ -f "$disk" ] || die "no VM disk yet; run vm/vm install first"
    start_virtiofsd
    extra=()
    if [ -n "${DASHI_VM_EXTRA_DISK:-}" ]; then
      [ -f "$DASHI_VM_EXTRA_DISK" ] || qemu-img create -q -f qcow2 "$DASHI_VM_EXTRA_DISK" 40G
      extra=(-drive file="$DASHI_VM_EXTRA_DISK",if=virtio,format=qcow2)
    fi
    qemu -drive file="$disk",if=virtio,format=qcow2 "${extra[@]}" \
      -chardev socket,id=fs0,path="$fs_sock" \
      -device vhost-user-fs-pci,chardev=fs0,tag=developer
    ;;
  live)
    iso=${1:-$(default_iso)}
    ensure_disk
    qemu -drive file="$iso",media=cdrom,readonly=on -boot order=d
    ;;
  ssh)
    # The VM's own key (made the first time, kept in vm/images/), not the host's agent.
    exec ssh -p "$ssh_port" -i "$images/id_ed25519" -o IdentitiesOnly=yes -o IdentityAgent=none \
      -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$images/known_hosts" \
      "${DASHI_VM_USER:-dashi}"@localhost "$@"
    ;;
  mcp)
    # The checkout's bridge when the VM runs the checkout's session, else the installed one.
    exec "$0" ssh -T -o BatchMode=yes \
      'if [ -x /mnt/developer/dashiOS/session/dashi-mcp ]; then exec /mnt/developer/dashiOS/session/dashi-mcp; else exec dashi-mcp; fi'
    ;;
  ipc)
    [ $# -ge 1 ] || die "usage: vm/vm ipc METHOD [JSON]"
    exec "$0" ssh -T -o BatchMode=yes python3 - "$(printf '%q' "$1")" "$(printf '%q' "${2:-{\}}")" < "$here/guest-ipc.py"
    ;;
  screenshot)
    out=$(readlink -f -- "${1:-$images/screen.png}")
    if python3 "$here/qmp.py" "$qmp_sock" screenshot "$out" 2>/dev/null; then echo "$out"; exit 0; fi
    # Dashi's agent integration: the compositor's capture, which works mid-drag
    # and with menus open (once "See the screen" is allowed in the VM).
    if "$here/agent" screenshot "$out" >/dev/null 2>&1; then echo "$out"; exit 0; fi
    # Venus scanouts are GPU memory QEMU cannot read, and the compositor
    # captures only for the shell: press the shell's ⇧❖3 and copy its newest
    # screenshot out (needs a running Dashi session in the VM).
    shots='$HOME/Pictures/Screenshots'
    before=$("$0" ssh -o BatchMode=yes "ls -t $shots 2>/dev/null | head -1" || true)
    python3 "$here/qmp.py" "$qmp_sock" key meta_l-shift-3
    for _ in $(seq 20); do
      sleep 0.5
      latest=$("$0" ssh -o BatchMode=yes "ls -t $shots 2>/dev/null | head -1" || true)
      if [ -n "$latest" ] && [ "$latest" != "$before" ]; then
        "$0" ssh -o BatchMode=yes "cat \"$shots/$latest\"" > "$out" && echo "$out" && exit 0
      fi
    done
    die "no screenshot appeared in the VM (is a Dashi session running?)"
    ;;
  type|key)
    exec python3 "$here/qmp.py" "$qmp_sock" "$cmd" "$@"
    ;;
  stop)
    exec python3 "$here/qmp.py" "$qmp_sock" powerdown
    ;;
  checkout-session)
    pass=${DASHI_VM_PASSWORD:?set DASHI_VM_PASSWORD to the VM user password, for sudo in the guest}
    case ${1:-} in
      on) script='
        printf "[Desktop Entry]\nName=Dashi (checkout)\nExec=/home/dashi/Developer/dashiOS/vm/dev-session\nType=Application\nDesktopNames=Dashi\n" > /usr/share/wayland-sessions/dashi-checkout.desktop
        printf "[Autologin]\nUser=dashi\nSession=dashi-checkout\n" > /etc/sddm.conf.d/zz-dashi-checkout.conf' ;;
      off) script='rm -f /usr/share/wayland-sessions/dashi-checkout.desktop /etc/sddm.conf.d/zz-dashi-checkout.conf' ;;
      *) die "usage: vm/vm checkout-session on|off" ;;
    esac
    printf '%s\n' "$pass" | "$0" ssh "sudo -S -p '' sh -c '$script && systemctl restart sddm'"
    ;;
  checkout-greeter)
    pass=${DASHI_VM_PASSWORD:?set DASHI_VM_PASSWORD to the VM user password, for sudo in the guest}
    case ${1:-} in
      # The checkout lives in dashi's home, so in the VM the greeter runs as dashi,
      # and greetd's domain (xdm_t) is permissive: it may not run code from a home.
      on) script='
        semanage permissive -a xdm_t 2>/dev/null || true
        rm -f /etc/sddm.conf.d/zz-dashi-checkout.conf
        printf "[Desktop Entry]\nName=Dashi (checkout)\nExec=/home/dashi/Developer/dashiOS/vm/dev-session\nType=Application\nDesktopNames=Dashi\n" > /usr/share/wayland-sessions/dashi-checkout.desktop
        printf "[Desktop Entry]\nName=Dashi (new compositor)\nExec=env DASHI_COMP=/home/dashi/Developer/dashiOS/target/debug/dashi-comp /home/dashi/Developer/dashiOS/vm/dev-session\nType=Application\nDesktopNames=Dashi\n" > /usr/share/wayland-sessions/dashi-checkout-comp.desktop
        printf "[terminal]\nvt = 1\n\n[default_session]\ncommand = \"/home/dashi/Developer/dashiOS/vm/dev-greeter\"\nuser = \"dashi\"\n" > /etc/greetd/config.toml
        systemctl disable sddm && systemctl enable --force greetd && systemctl stop sddm; systemctl restart greetd' ;;
      off) script='
        semanage permissive -d xdm_t 2>/dev/null || true
        systemctl disable greetd && systemctl enable --force sddm && systemctl stop greetd; systemctl restart sddm' ;;
      *) die "usage: vm/vm checkout-greeter on|off" ;;
    esac
    printf '%s\n' "$pass" | "$0" ssh "sudo -S -p '' sh -c '$script'"
    ;;
  *)
    sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
    [ -z "$cmd" ] || exit 2
    ;;
esac
