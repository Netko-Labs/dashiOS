#!/usr/bin/sh
# vm/dev-greeter: in the VM, the checkout's login screen (session/dashi-greeter),
# as greetd runs it (`vm/vm checkout-greeter on`). The checkout's dashi-comp
# cannot drive screens until C1 (docs/compositor.md), so until then the login
# screen runs on the installed one. DASHI_COMP picks another.
set -eu
repo=$(dirname -- "$(dirname -- "$(readlink -f -- "$0")")")
export DASHI_COMP=${DASHI_COMP:-/usr/bin/dashi-comp}
exec "$repo/session/dashi-greeter" "$@"
