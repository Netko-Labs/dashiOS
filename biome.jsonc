// Biome for Dashi: mirin's rules (../mirin/biome.jsonc, docs/conventions.md),
// at Dashi's line width.
{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      // H5 (docs/conventions.md, "Hard rules"): no import cycles. Today's are let
      // through by a suppression comment scripts/check-biome.ts counts (scripts/lists/import-cycles.txt).
      "nursery": {
        "noImportCycles": "error"
      },
      "complexity": {
        // H3: no function over 80 lines. Today's longer ones are in the overrides
        // below, each file held at its longest (scripts/lists/long-functions.txt).
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 80
          }
        }
      },
      "correctness": {
        "noUnusedImports": "error",
        "useUniqueElementIds": "off",
        // `return close();` in a function typed void: Dashi's early-return idiom.
        "noVoidTypeReturn": "off"
      },
      "suspicious": {
        // Dashi strips and refuses control characters in untrusted text on
        // purpose (docs/conventions.md, "Security Boundaries").
        "noControlCharactersInRegex": "off",
        // `cache ??= load()` and `(this.run = new AbortController())`: lazy and
        // held values, as docs/conventions.md prefers them.
        "noAssignInExpressions": "off",
        "noArrayIndexKey": "off",
        "noShadowRestrictedNames": "off",
        "noUnknownAtRules": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useValidAnchor": "off",
        "useSemanticElements": "off",
        "noStaticElementInteractions": "off",
        "noAutofocus": "off",
        "noLabelWithoutControl": "off",
        "useKeyWithClickEvents": "off"
      },
      "style": {
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": {
                  "kind": "objectLiteralProperty",
                  "scope": "any"
                },
                "formats": ["camelCase", "CONSTANT_CASE", "PascalCase", "snake_case"]
              },
              {
                "selector": {
                  "kind": "typeProperty",
                  "scope": "any"
                },
                "formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
              },
              {
                "selector": {
                  "kind": "function",
                  "scope": "any"
                },
                "formats": ["camelCase", "PascalCase"]
              }
            ]
          }
        },
        "useFilenamingConvention": "off",
        "noUselessElse": "error",
        "useImportType": "error",
        "useConst": "error",
        "useAsConstAssertion": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error",
        "noUnusedTemplateLiteral": "error",
        "useNumberNamespace": "error",
        "noInferrableTypes": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 160,
    "attributePosition": "auto"
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "quoteStyle": "double",
      "attributePosition": "auto"
    }
  },
  "json": {
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": true
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.git",
      "!**/.mirin",
      "!.claude/worktrees",
      "!**/target",
      "!**/vendor",
      "!**/vendor/cef",
      "!**/dist",
      "!**/build",
      "!**/.turbo",
      "!**/.next",
      "!**/.output",
      "!**/generated",
      "!test/fixtures/ipc",
      "!**/*.generated.ts",
      "!**/routeTree.gen.ts",
      "!bun.lock",
      "!Cargo.lock",
      "!comp"
    ]
  },
  "overrides": [
    // A test's describe block is not a function to split (H3).
    { "includes": ["**/test/**"], "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": "off" } } } },
    // H3 overrides: written by `bun scripts/check-biome.ts --shrink`; do not edit by hand.
    {
      "includes": ["packages/applet/src/define.ts"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 99 } } } } }
    },
    {
      "includes": ["packages/dashi-ui/src/slider.tsx"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 82 } } } } }
    },
    {
      "includes": ["packages/shell/src/actions/start.ts"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 109 } } } } }
    },
    {
      "includes": ["packages/shell/src/agent-sheets.tsx"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 158 } } } } }
    },
    {
      "includes": ["packages/shell/src/agents/ask/service.ts"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 121 } } } } }
    },
    {
      "includes": ["packages/shell/src/agents/handoff/questions.ts"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 144 } } } } }
    },
    {
      "includes": ["packages/shell/src/agents/handoff/runner.ts"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 90 } } } } }
    },
    { "includes": ["packages/shell/src/agents/handoff/service.ts"], "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": "off" } } } },
    {
      "includes": ["packages/shell/src/agents/run.ts"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 171 } } } } }
    },
    {
      "includes": ["packages/shell/src/agents/server.ts"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 169 } } } } }
    },
    {
      "includes": ["packages/shell/src/bluetooth/agent.ts"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 81 } } } } }
    },
    {
      "includes": ["packages/shell/src/clipboard/start.ts"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 128 } } } } }
    },
    {
      "includes": ["packages/shell/src/control-center/controls.tsx"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 146 } } } } }
    },
    {
      "includes": ["packages/shell/src/control-center/panel.tsx"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 104 } } } } }
    },
    {
      "includes": ["packages/shell/src/dock/view.tsx"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 103 } } } } }
    },
    {
      "includes": ["packages/shell/src/handoff-shell.tsx"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 92 } } } } }
    },
    {
      "includes": ["packages/shell/src/laptop/start.ts"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 163 } } } } }
    },
    { "includes": ["packages/shell/src/launcher.tsx"], "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": "off" } } } },
    {
      "includes": ["packages/shell/src/launcher/extensions.ts"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 137 } } } } }
    },
    {
      "includes": ["packages/shell/src/main.tsx"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 120 } } } } }
    },
    {
      "includes": ["packages/shell/src/menubar-slots.tsx"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 90 } } } } }
    },
    {
      "includes": ["packages/shell/src/menubar-status.tsx"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 98 } } } } }
    },
    {
      "includes": ["packages/shell/src/menubar.tsx"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 212 } } } } }
    },
    {
      "includes": ["packages/shell/src/menus/start.tsx"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 230 } } } } }
    },
    {
      "includes": ["packages/shell/src/notifications/center.tsx"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 82 } } } } }
    },
    {
      "includes": ["packages/shell/src/polkit/service.ts"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 88 } } } } }
    },
    {
      "includes": ["packages/shell/src/settings-app/machine-desktop.ts"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 132 } } } } }
    },
    {
      "includes": ["packages/shell/src/settings-app/panes/arrangement.tsx"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 81 } } } } }
    },
    {
      "includes": ["packages/shell/src/settings-app/start.tsx"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 99 } } } } }
    },
    {
      "includes": ["packages/shell/src/setup/start.tsx"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 98 } } } } }
    },
    {
      "includes": ["packages/shell/src/share-picker/start.tsx"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 88 } } } } }
    },
    {
      "includes": ["packages/shell/src/shortcuts.ts"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 89 } } } } }
    },
    {
      "includes": ["packages/shell/src/spaces/row.tsx"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 122 } } } } }
    },
    {
      "includes": ["packages/shell/src/spaces/start.tsx"],
      "linter": { "rules": { "complexity": { "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 125 } } } } }
    }
    // H3 overrides end.
  ]
}
