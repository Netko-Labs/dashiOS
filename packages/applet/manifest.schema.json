{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Netko-Labs/dashiOS/packages/applet/manifest.schema.json",
  "title": "applet.json",
  "description": "A Dashi applet's manifest: who it is, when it applies, and what it may touch (docs/applets.md). src/manifest.ts is the authority; this is for editors.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "dashi", "entry", "summary", "author"],
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "description": "Reverse-DNS in lowercase, such as dev.example.weather.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(\\.[a-z0-9][a-z0-9-]*){2,}$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 40 },
    "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$" },
    "dashi": { "description": "The Dashi versions it runs on.", "type": "string", "pattern": "^(>=|\\^|~)?\\d+(\\.\\d+){0,2}$", "examples": [">=0.4"] },
    "entry": { "description": "The source file main.js is built from.", "type": "string", "pattern": "\\.(tsx?|jsx?)$" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 2000 },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "url": { "type": "string", "pattern": "^https://" },
        "email": { "type": "string" }
      }
    },
    "license": { "type": "string", "maxLength": 40 },
    "source": { "type": "string", "pattern": "^https://" },
    "categories": {
      "type": "array",
      "maxItems": 3,
      "items": { "enum": ["hardware", "productivity", "network", "status", "media", "developer", "utilities"] }
    },
    "when": {
      "description": "Every condition given must hold; a list is any of; a trailing * is a prefix.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vendor": { "$ref": "#/$defs/patterns" },
        "product": { "$ref": "#/$defs/patterns" },
        "board": { "$ref": "#/$defs/patterns" },
        "family": { "$ref": "#/$defs/patterns" },
        "laptop": { "type": "boolean" },
        "hardware": { "type": "array", "maxItems": 16, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,40}$" } }
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "anyOf": [
          { "enum": ["network", "notifications", "hardware.sensors", "hardware.power", "hardware.lighting", "hardware.fans", "hardware.tuning"] },
          { "type": "string", "pattern": "^dbus\\.(system|session):[A-Za-z_][A-Za-z0-9_-]*(\\.[A-Za-z_][A-Za-z0-9_-]*)+$" },
          { "type": "string", "pattern": "^files\\.(downloads|documents|pictures|music|videos|desktop)(:read)?$" }
        ]
      }
    },
    "screenshots": { "type": "array", "maxItems": 8, "items": { "type": "string", "pattern": "\\.(png|jpe?g|webp)$" } },
    "icon": { "type": "string", "pattern": "\\.(svg|png)$" }
  },
  "$defs": {
    "patterns": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 128 },
        { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 128 } }
      ]
    }
  }
}
