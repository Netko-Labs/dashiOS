#!/usr/bin/sh
#
# livesys-dashi: Dashi's live session, sourced by livesys-main (livesys-scripts)
# at the live image's first boot, after it has made `liveuser`. Only the live
# session gets these; the installed system is the image as built, with a
# login screen.

# SDDM logs liveuser into Dashi.
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/zz-livesys-dashi.conf << SDDM_EOF
[Autologin]
User=liveuser
Session=dashi.desktop
SDDM_EOF

# The installer starts without a password prompt (liveuser has none), as on
# Fedora's GNOME live image.
cat > /usr/share/polkit-1/rules.d/20-livesys-dashi.rules << POLKIT_EOF
polkit.addRule(function(action, subject) {
    if (!subject.local)
        return undefined;
    if (subject.user !== 'liveuser')
        return undefined;
    if (action.id.indexOf('org.fedoraproject.pkexec.liveinst') !== 0)
        return undefined;
    return 'yes';
});
POLKIT_EOF

# "Install Dashi" in the launcher (and the Setup Assistant's first page, which
# looks for liveinst on a live boot).
cat > /usr/share/applications/dashi-install.desktop << DESKTOP_EOF
[Desktop Entry]
Type=Application
Name=Install Dashi
GenericName=Installer
Comment=Install Dashi on this computer
Exec=liveinst
Icon=org.fedoraproject.AnacondaInstaller
Categories=System;
Keywords=install;installer;anaconda;disk;
DESKTOP_EOF

# Turn off PackageKit-command-not-found while running live, as Fedora does.
if [ -f /etc/PackageKit/CommandNotFound.conf ]; then
  sed -i -e 's/^SoftwareSourceSearch=true/SoftwareSourceSearch=false/' /etc/PackageKit/CommandNotFound.conf
fi
