#!/usr/bin/env bash
# spin/build-rpms: Dashi's packages from this checkout, with rpmbuild. Run it
# on any Fedora 44 machine set up for it (the laptop is; the VM works too,
# slower): it needs a clean tree and `bun install` done at the root (the
# shell's runtime packages are copied from node_modules), ../mirin checked
# out, and the build dependencies the specs name (`sudo dnf builddep spin/rpm/*.spec`, with the pejedev/dashi
# COPR enabled for libghostty-vt-devel 1.4).
#
#   spin/build-rpms [package...|all]   default: dashi dashi-comp dashi-hardware dashi-secretd dashi-greeter dashi-release dashi-live
#   all: every spec in spin/rpm (mirin-metal-host from ../mirin's HEAD; dashi-bun
#   downloads Bun's release, with spectool)
#
# The RPMs land in ~/rpmbuild/RPMS; Cargo builds under ~/rpmbuild/cargo-target.
#
# What is built is what is committed: Dashi's HEAD and mirin's HEAD, each taken
# with `git archive`, so an untracked file or an uncommitted change in either
# tree cannot get in. Dashi's tree must be clean (tracked files); a dirty mirin
# is built at its HEAD, and says so. vendor/MIRIN_COMMIT names the commit the
# packages really hold.
set -euo pipefail

repo=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)
mirin=$(cd -- "$repo/../mirin" && pwd)
version=0.7.0
cd "$repo"

if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  echo "build-rpms: the tree has uncommitted changes; packages are built from HEAD" >&2
  exit 1
fi
sha=$(git rev-parse --short=7 HEAD)
# The commit's UTC date and time, then its hash: two builds of one day sort by
# time (a hash alone sorted them at random), and a numeric time sorts above
# the hashes the older DATE.SHA snapshots had there.
stamp() { TZ=UTC git -C "$1" log -1 --format=%cd --date=format-local:%Y%m%d.%H%M%S; }
snapshot="$version~beta.$(stamp "$repo").$sha"
packages=("$@")
[ ${#packages[@]} -gt 0 ] || packages=(dashi dashi-comp dashi-hardware dashi-secretd dashi-greeter dashi-release dashi-live)
if [ "${packages[0]}" = all ]; then
  packages=()
  for spec in "$repo"/spin/rpm/*.spec; do packages+=("$(basename "$spec" .spec)"); done
fi

top=${RPMBUILD_TOP:-$HOME/rpmbuild}
mkdir -p "$top"/{SOURCES,SPECS,BUILD,RPMS,SRPMS}
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT

# The source: HEAD, plus the shell's runtime packages, flattened (node_modules
# here is Bun's isolated layout of symlinks).
name=dashi-$snapshot
git archive --format=tar --prefix="$name/" HEAD | tar -x -C "$stage"
src=$stage/$name
modules=$src/vendor/node_modules
mkdir -p "$modules/@mirinjs" "$modules/@dashi"
# copy_module <destination> <installed package dir>...: the first dir that
# exists (the arguments are one glob, expanded by the caller).
copy_module() {
  [ -d "$2" ] || { echo "build-rpms: missing ${2##*/} (run bun install)" >&2; exit 1; }
  cp -rL "$2" "$1"
}
bun_dir="$repo/node_modules/.bun"
copy_module "$modules/react" "$bun_dir"/react@*/node_modules/react
copy_module "$modules/react-reconciler" "$bun_dir"/react-reconciler@*/node_modules/react-reconciler
copy_module "$modules/scheduler" "$bun_dir"/scheduler@*/node_modules/scheduler
# The Anthropic SDK (the launcher's Claude answerer) and what it loads at run time; json-schema-to-ts is types only.
mkdir -p "$modules/@anthropic-ai" "$modules/@opentelemetry" "$modules/@stablelib"
copy_module "$modules/@anthropic-ai/sdk" "$bun_dir"/@anthropic-ai+sdk@*/node_modules/@anthropic-ai/sdk
copy_module "$modules/@opentelemetry/api" "$bun_dir"/@opentelemetry+api@*/node_modules/@opentelemetry/api
copy_module "$modules/standardwebhooks" "$bun_dir"/standardwebhooks@*/node_modules/standardwebhooks
copy_module "$modules/@stablelib/base64" "$bun_dir"/@stablelib+base64@*/node_modules/@stablelib/base64
copy_module "$modules/fast-sha256" "$bun_dir"/fast-sha256@*/node_modules/fast-sha256
# OpenAI's SDK (the launcher's GPT answerer): the client needs nothing else at run time; ws, zod and undici are
# optional peers for its realtime and helper subpaths, which Dashi doesn't load.
copy_module "$modules/openai" "$bun_dir"/openai@*/node_modules/openai
# Dashi's own packages come from the archive above, never from the working tree.
mkdir -p "$modules/@dashi/ui" "$modules/@dashi/applet"
cp -r "$src/packages/dashi-ui/src" "$src/packages/dashi-ui/package.json" "$modules/@dashi/ui/"
cp -r "$src/packages/applet/src" "$src/packages/applet/package.json" "$src/packages/applet/manifest.schema.json" "$modules/@dashi/applet/"
# mirin's @mirinjs/metal, from mirin's HEAD.
mirin_sha=$(git -C "$mirin" rev-parse --short=7 HEAD)
if [ -n "$(git -C "$mirin" status --porcelain)" ]; then
  echo "build-rpms: warning: $mirin has uncommitted changes; they are not in the packages (mirin $mirin_sha is)" >&2
fi
git -C "$mirin" archive --format=tar --prefix=mirin/ HEAD packages/mirin-metal/src packages/mirin-metal/package.json LICENSE | tar -x -C "$stage"
mkdir -p "$modules/@mirinjs/metal"
cp -r "$stage/mirin/packages/mirin-metal/src" "$stage/mirin/packages/mirin-metal/package.json" "$modules/@mirinjs/metal/"
[ ! -f "$stage/mirin/LICENSE" ] || cp "$stage/mirin/LICENSE" "$modules/@mirinjs/metal/"
rm -rf "$stage/mirin"
echo "$mirin_sha" > "$src/vendor/MIRIN_COMMIT"
# Dashi's browser extension, signed (dashi-helium installs it): the key never
# leaves this machine and is never in the repository (docs/actions.md, "Websites").
extension_key=${DASHI_EXTENSION_KEY:-$HOME/.config/dashi-build/browser-extension.pem}
if [ -f "$extension_key" ]; then
  bun "$src/packages/shell/bin/dashi-browser-pack.ts" --key "$extension_key" --out "$src/vendor/browser" >/dev/null
  rm -rf "$src/vendor/browser/unpacked"
elif [[ " ${packages[*]} " == *" dashi-helium "* ]]; then
  echo "build-rpms: dashi-helium needs the extension's key at $extension_key (or set DASHI_EXTENSION_KEY)" >&2
  exit 1
fi
tar -C "$stage" -czf "$top/SOURCES/$name.tar.gz" "$name"

# mirin's source, for mirin-metal-host: its HEAD, as Dashi's tree pins it by commit.
mirin_snapshot="0.1.0~beta.$(stamp "$mirin").$mirin_sha"
mirin_name=mirin-$mirin_snapshot
if [[ " ${packages[*]} " == *" mirin-metal-host "* ]]; then
  git -C "$mirin" archive --format=tar.gz --prefix="$mirin_name/" -o "$top/SOURCES/$mirin_name.tar.gz" HEAD
fi

for package in "${packages[@]}"; do
  spec=$repo/spin/rpm/$package.spec
  [ -f "$spec" ] || { echo "build-rpms: no spec for $package" >&2; exit 1; }
  echo "build-rpms: $package $snapshot"
  # Sources at URLs (dashi-bun's release) are fetched first.
  if grep -q '^Source[0-9]*:[[:space:]]*https://' "$spec"; then
    spectool -g -C "$top/SOURCES" "$spec"
  fi
  # The snapshot and source names go into the spec itself, so the SRPM
  # rebuilds anywhere (COPR) without these --defines.
  staged=$top/SPECS/$package.spec
  mkdir -p "$top/SPECS"
  {
    echo "%global dashi_snapshot $snapshot"
    echo "%global dashi_source $name"
    echo "%global mirin_snapshot $mirin_snapshot"
    echo "%global mirin_source $mirin_name"
    cat "$spec"
  } > "$staged"
  rpmbuild -ba "$staged" \
    --define "_topdir $top" \
    --define "cargo_target ${CARGO_TARGET_DIR:-$top/cargo-target}"
done
# No file may belong to two of Dashi's packages (the newest build of each):
# dnf refuses such a pair, and the image build would fail far later.
newest=$(find "$top"/RPMS -name '*.rpm' ! -name '*-debug*' -printf '%T@ %p\n' | sort -rn | cut -d' ' -f2- | while read -r rpm; do
  printf '%s %s\n' "$(rpm -qp --qf '%{NAME}' "$rpm" 2>/dev/null)" "$rpm"
done | awk '!seen[$1]++ {print $2}')
clashes=$(for rpm in $newest; do
  name=$(rpm -qp --qf '%{NAME}' "$rpm" 2>/dev/null)
  rpm -qp --qf '[%{FILEMODES:perms} %{FILENAMES}\n]' "$rpm" 2>/dev/null | awk -v n="$name" '$1 !~ /^d/ {print $2, n}'
done | sort | awk '{ if ($1 == last) print $1": "owner" and "$2; last = $1; owner = $2 }' | grep -v '/usr/lib/.build-id/' || true)
if [ -n "$clashes" ]; then
  echo "build-rpms: files in two packages:" >&2
  echo "$clashes" >&2
  exit 1
fi
echo "build-rpms: done; see $top/RPMS"
