[Unit]
Description=Dashi hardware boot guard (mark a clean shutdown)
Documentation=https://github.com/Netko-Labs/dashiOS/blob/main/docs/hardware.md
DefaultDependencies=no
After=dashi-hardware-boot.service
Before=shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Nothing at start-up; the work is at stop, ordered before shutdown: this
# boot reached a clean shutdown, so the unclean-boot counter resets.
ExecStop=/usr/libexec/dashi/dashi-hardware clean
StateDirectory=dashi-hardware
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateNetwork=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
UMask=0077
LimitCORE=0
# It reads sysfs and writes its state file, nothing more.
RestrictAddressFamilies=none
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
