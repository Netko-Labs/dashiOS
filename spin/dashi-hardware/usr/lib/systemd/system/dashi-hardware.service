[Unit]
Description=Dashi's hardware helper (dev.dashi.Hardware1)
Documentation=https://github.com/Netko-Labs/dashiOS/blob/main/docs/hardware.md

[Service]
Type=dbus
BusName=dev.dashi.Hardware1
ExecStart=/usr/libexec/dashi/dashi-hardware serve
# It writes firmware attributes, hwmon and the PCI root complex's config
# space (the SMU), so it stays root; it is otherwise confined. Everything it
# writes is under /sys (sysfs, the SMU's PCI config), plus /dev/hidraw* (the
# Slash bar) and its state directory; everything else is read-only or hidden.
# This unit scores 1.6 on `systemd-analyze security` (spin/check-units holds it
# at 5.0 or better). ProtectKernelTunables is off on purpose: it makes /sys
# read-only, and /sys is what this service writes. The three capabilities kept
# are for what only the real laptop can show (docs/hardware.md, "The service's
# sandbox"): CAP_SYS_RAWIO for the PCI config writes, CAP_DAC_OVERRIDE for a
# sysfs file that isn't root's to write.
StateDirectory=dashi-hardware
StateDirectoryMode=0700
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/sys/class /sys/devices /sys/firmware/acpi
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
# AF_UNIX only: the system bus.
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=CAP_SYS_RAWIO CAP_DAC_OVERRIDE
# The Slash bar's /dev/hidraw nodes, and nothing else.
DevicePolicy=closed
DeviceAllow=char-hidraw rw
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
