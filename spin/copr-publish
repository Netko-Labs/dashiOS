#!/usr/bin/env bash
# spin/copr-publish: Dashi's packages to its COPR, from the source RPMs
# spin/build-rpms made (~/rpmbuild/SRPMS). Publishing is the owner's: it needs
# copr-cli and their API token in ~/.config/copr
# (https://copr.fedorainfracloud.org/api/). The first run creates the project.
# Afterwards, set enabled=1 in spin/dashi-release/etc/yum.repos.d/dashi.repo
# (owner and project must match) so installed systems update through dnf.
#
#   spin/copr-publish [owner/project]   default: pejedev/dashi
set -euo pipefail

project=${1:-pejedev/dashi}
top=${RPMBUILD_TOP:-$HOME/rpmbuild}
command -v copr-cli >/dev/null || { echo "copr-publish: install copr-cli" >&2; exit 1; }
[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/copr" ] || { echo "copr-publish: no COPR token in ~/.config/copr" >&2; exit 1; }
shopt -s nullglob
srpms=("$top"/SRPMS/*.src.rpm)
[ ${#srpms[@]} -gt 0 ] || { echo "copr-publish: no source RPMs in $top/SRPMS; run spin/build-rpms all" >&2; exit 1; }

# Cargo fetches crates while building (dashi-comp, mirin-metal-host): the
# builders need the network. The CachyOS kernel, Helium, and RPM Fusion come
# from their own repositories.
if ! copr-cli get "$project" >/dev/null 2>&1; then
  copr-cli create "$project" \
    --chroot fedora-44-x86_64 \
    --enable-net on \
    --repo 'copr://bieszczaders/kernel-cachyos' \
    --repo 'copr://imput/helium' \
    --repo 'https://mirrors.rpmfusion.org/mirrorlist?repo=free-fedora-$releasever&arch=$basearch' \
    --repo 'https://mirrors.rpmfusion.org/mirrorlist?repo=nonfree-fedora-$releasever&arch=$basearch' \
    --description "Dashi, a desktop on Fedora: the compositor, the shell, the login screen."
fi
for srpm in "${srpms[@]}"; do
  echo "copr-publish: $(basename "$srpm")"
  copr-cli build --nowait "$project" "$srpm"
done
echo "copr-publish: submitted; watch https://copr.fedorainfracloud.org/coprs/$project/builds/"
