#!/usr/bin/env bash
# spin/copr-publish: Dashi's packages to its COPR, from the source RPMs one
# spin/build-rpms run made (the set its manifest names, in ~/rpmbuild/SRPMS).
# Nothing else in that shared folder is sent. Publishing is the owner's: it needs
# copr-cli and their API token in ~/.config/copr
# (https://copr.fedorainfracloud.org/api/). The first run creates the project.
# Afterwards, set enabled=1 in spin/dashi-release/etc/yum.repos.d/dashi.repo
# (owner and project must match) so installed systems update through dnf.
#
#   spin/copr-publish [owner/project [manifest]]   default: pejedev/dashi, the last run's
#                                                  (SRPMS/latest.manifest; or SRPMS/<snapshot>.manifest)
set -euo pipefail

project=${1:-pejedev/dashi}
top=${RPMBUILD_TOP:-$HOME/rpmbuild}
command -v copr-cli >/dev/null || { echo "copr-publish: install copr-cli" >&2; exit 1; }
[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/copr" ] || { echo "copr-publish: no COPR token in ~/.config/copr" >&2; exit 1; }
manifest=${2:-$top/SRPMS/latest.manifest}
[ -f "$manifest" ] || { echo "copr-publish: no manifest at $manifest; run spin/build-rpms first" >&2; exit 1; }
# The run's own source RPMs, each of which must exist.
srpms=()
while IFS= read -r file; do
  [ -n "$file" ] || continue
  [ -f "$top/SRPMS/$file" ] || { echo "copr-publish: $manifest names $file, which is not in $top/SRPMS" >&2; exit 1; }
  srpms+=("$top/SRPMS/$file")
done < "$manifest"
[ ${#srpms[@]} -gt 0 ] || { echo "copr-publish: $manifest is empty" >&2; exit 1; }
echo "copr-publish: ${#srpms[@]} source RPMs from $manifest"

# Cargo fetches crates while building (dashi-comp, mirin-metal-host): the
# builders need the network. The CachyOS kernel, Helium, and RPM Fusion come
# from their own repositories. COPR takes every repository as a baseurl (a
# mirrorlist URL fails), and the settings are applied on every run so a
# project made by an older copy of this script is corrected.
rpmfusion=https://download1.rpmfusion.org
settings=(
  --enable-net on
  --repo 'copr://bieszczaders/kernel-cachyos'
  --repo 'copr://imput/helium'
  --repo "$rpmfusion/free/fedora/releases/\$releasever/Everything/\$basearch/os/"
  --repo "$rpmfusion/free/fedora/updates/\$releasever/\$basearch/"
  --repo "$rpmfusion/nonfree/fedora/releases/\$releasever/Everything/\$basearch/os/"
  --repo "$rpmfusion/nonfree/fedora/updates/\$releasever/\$basearch/"
  --description "Dashi, a desktop on Fedora: the compositor, the shell, the login screen."
)
if copr-cli get "$project" >/dev/null 2>&1; then
  copr-cli modify "$project" "${settings[@]}"
else
  copr-cli create "$project" --chroot fedora-44-x86_64 "${settings[@]}"
fi
for srpm in "${srpms[@]}"; do
  echo "copr-publish: $(basename "$srpm")"
  copr-cli build --nowait "$project" "$srpm"
done
echo "copr-publish: submitted; watch https://copr.fedorainfracloud.org/coprs/$project/builds/"
