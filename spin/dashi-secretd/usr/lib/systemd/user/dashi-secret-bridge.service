# The Secret Service and the portal's Secret on your session bus, backed by
# dashi-secretd. The session starts it (src/session/lib/keyring.ts); D-Bus starts
# it too, when an app asks first.
[Unit]
Description=Dashi's Secret Service
Documentation=https://github.com/Netko-Labs/dashiOS/blob/main/docs/secrets.md
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.freedesktop.secrets
ExecStart=/usr/libexec/dashi/dashi-secret-bridge
Restart=on-failure
LimitCORE=0
NoNewPrivileges=yes
