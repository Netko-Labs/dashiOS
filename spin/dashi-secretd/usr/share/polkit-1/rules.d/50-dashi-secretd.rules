// dashi-secretd checks a fingerprint itself before a passkey or a payment
// is used (docs/secrets.md), so a yes by finger is its own finding.
// It may verify, never enroll or delete.
polkit.addRule(function (action, subject) {
  if (action.id == "net.reactivated.fprint.device.verify" && subject.user == "dashi-secret") {
    return polkit.Result.YES;
  }
});
