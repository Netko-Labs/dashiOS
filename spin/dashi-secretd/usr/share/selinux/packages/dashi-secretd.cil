; dashi-secretd: the login opens the vault (docs/secrets.md). greetd runs the
; vault's PAM helper (pam_exec) in xdm_t, which may not write to the generic
; var_run_t; the vault's runtime directory gets a type of its own, and xdm_t
; may reach its socket and nothing else of it.
(type dashi_secretd_run_t)
(roletype object_r dashi_secretd_run_t)
(typeattributeset file_type (dashi_secretd_run_t))
(typeattributeset non_security_file_type (dashi_secretd_run_t))
(typeattributeset non_auth_file_type (dashi_secretd_run_t))
(filecon "/run/dashi-secretd(/.*)?" any (system_u object_r dashi_secretd_run_t ((s0) (s0))))
(allow xdm_t dashi_secretd_run_t (dir (search getattr)))
(allow xdm_t dashi_secretd_run_t (sock_file (write getattr open)))
