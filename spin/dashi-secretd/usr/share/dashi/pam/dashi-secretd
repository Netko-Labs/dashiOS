# The lines dashi-secretd's package adds to /etc/pam.d/greetd (and that any
# other display manager's PAM file can take): the login password opens the
# vault, the session's end locks it. Optional: the vault never fails a login.
-auth     optional  pam_exec.so expose_authtok quiet /usr/libexec/dashi/dashi-secretd-pam
-session  optional  pam_exec.so quiet /usr/libexec/dashi/dashi-secretd-pam
