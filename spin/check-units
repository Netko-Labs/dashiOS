#!/usr/bin/env bash
# spin/check-units: the systemd units Dashi packages. Each system unit under
# spin/*/usr/lib/systemd/system must parse, and score 5.0 or better ("OK" or
# "SAFE") on `systemd-analyze security` (offline: the units name binaries that
# are not installed here, so `verify` is left to the VM), unless it is listed in UNSANDBOXED
# with the reason. The privileged helpers (dashi-hardware, dashi-secretd) are
# the ones that matter: a root service with no sandbox is an attack surface.
#
#   spin/check-units [--max SCORE]
set -euo pipefail

max=5.0
if [ "${1:-}" = --max ]; then
  [ $# -ge 2 ] || { echo "check-units: --max needs a score" >&2; exit 2; }
  max=$2
elif [ $# -gt 0 ]; then
  echo "usage: spin/check-units [--max SCORE]" >&2
  exit 2
fi
repo=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)
cd "$repo"

# unit name -> why it is not sandboxed (yet)
declare -A UNSANDBOXED=(
  [dashi-default-kernel.service]="runs grubby and rewrites the boot loader's entries, which needs /boot and the kernel tools; time-limited instead"
)

failed=0
while IFS= read -r unit; do
  name=${unit##*/}
  score=$(systemd-analyze security --offline=true --no-pager "$unit" 2>/dev/null | awk '/Overall exposure/ {print $(NF-2)}')
  if [ -z "$score" ]; then
    echo "FAIL  $name: no score (does the unit parse?)"
    failed=1
  elif [ -n "${UNSANDBOXED[$name]:-}" ]; then
    echo "skip  $name: $score (${UNSANDBOXED[$name]})"
  elif awk -v s="$score" -v m="$max" 'BEGIN { exit !(s > m) }'; then
    echo "FAIL  $name: exposure $score, more than $max"
    failed=1
  else
    echo "ok    $name: $score"
  fi
done < <(git ls-files 'spin/*/usr/lib/systemd/system/*.service')
exit "$failed"
