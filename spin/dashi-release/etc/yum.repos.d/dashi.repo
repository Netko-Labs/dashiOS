# Dashi's own packages (dashi, dashi-comp, dashi-greeter, mirin-metal-host,
# dashi-bun, dashi-release, ...), from COPR pejedev/dashi, published by
# spin/copr-publish. Installed systems get Dashi's updates through dnf; if
# COPR is down, dnf skips this repository rather than failing.
[copr:copr.fedorainfracloud.org:pejedev:dashi]
name=Dashi (COPR pejedev/dashi)
baseurl=https://download.copr.fedorainfracloud.org/results/pejedev/dashi/fedora-$releasever-$basearch/
type=rpm-md
skip_if_unavailable=True
gpgcheck=1
gpgkey=https://download.copr.fedorainfracloud.org/results/pejedev/dashi/pubkey.gpg
repo_gpgcheck=0
enabled=1
enabled_metadata=1
